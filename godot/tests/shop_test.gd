extends SceneTree
## The shop between rounds, through real clicks. For each fx.shopui scenario
## (40 runs, 435 steps generated by the real JS applying the web shop
## handlers), open ShopScreen, click the control that matches each JS action
## with real mouse events, and compare the run to the JS snapshot after every
## step. Also checks what the screen shows (Glim, offers, stall, disabled
## states) and the layout at three shapes.
##   godot --headless --path godot --script res://tests/shop_test.gd
const SHAPES := [Vector2i(720, 1280), Vector2i(720, 1560), Vector2i(960, 1280)]
var checks := 0
var fails := 0
var clicks := 0
var steps_done := 0
var P


func ok(c: bool, m: String) -> void:
	checks += 1
	if not c:
		fails += 1
		if fails <= 10:
			print("FAIL ", m)


func _initialize() -> void:
	_go.call_deferred()


func _click(at: Vector2) -> void:
	for pressed in [true, false]:
		var e := InputEventMouseButton.new()
		e.button_index = MOUSE_BUTTON_LEFT
		e.pressed = pressed
		e.position = at
		e.global_position = at
		Input.parse_input_event(e)
		Input.flush_buffered_events()
		await process_frame
	clicks += 1


func snap(run) -> Dictionary:
	var lv := {}
	for k in run.levels:
		lv[k] = run.levels[k]
	return {
		"essence": run.essence, "charms": run.charms.map(func(c): return c.id), "levels": lv,
		"deck": run.cards.size(), "last": P.card_out(run.cards[run.cards.size() - 1]),
		"offer": run.shop_state.offer.map(func(c): return c.id),
		"cards": run.shop_state.cards.map(func(e): return [P.card_out(e.card), e.cost, bool(e.get("sold", false))]),
		"rerolls": run.shop_state.rerolls, "rerollCost": run.reroll_cost(), "full": run.is_full(), "slots": run.slots()}


## The control that performs a JS action, or null if the screen doesn't offer it.
func control_for(s: ShopScreen, act: Array) -> Control:
	match act[0]:
		"charm": return s.offer_buttons.get(act[1])
		"card": return s.card_buttons.get(int(act[1]))
		"reroll": return s.reroll_button
		"level": return s.level_buttons.get(act[1])
		"sell": return s.sell_buttons.get(act[1])
	return null


## What the screen shows must agree with the run.
func check_display(s: ShopScreen, run, where: String) -> void:
	ok(s.essence_label.text == "%d Glim" % run.essence, "%s: Glim label %s" % [where, s.essence_label.text])
	var owned := {}
	for c in run.charms:
		owned[c.id] = true
	var want_offers := []
	for ch in run.shop_state.offer:
		if not owned.has(ch.id):
			want_offers.append(ch.id)
			var b: Button = s.offer_buttons.get(ch.id)
			if b != null:
				ok(b.disabled == (ch.cost > run.essence or run.is_full()), "%s: offer %s disabled=%s" % [where, ch.id, b.disabled])
	var got_offers: Array = s.offer_buttons.keys()
	got_offers.sort()
	want_offers.sort()
	ok(got_offers == want_offers, "%s: offers shown %s want %s" % [where, got_offers, want_offers])
	var want_cards := []
	for i in run.shop_state.cards.size():
		var e: Dictionary = run.shop_state.cards[i]
		if not e.get("sold", false):
			want_cards.append(i)
			var b: Button = s.card_buttons.get(i)
			if b != null:
				ok(b.disabled == (run.essence < e.cost) and b.text == str(e.cost), "%s: stall %d button" % [where, i])
	var got_cards: Array = s.card_buttons.keys()
	got_cards.sort()
	ok(got_cards == want_cards, "%s: stall shown %s want %s" % [where, got_cards, want_cards])
	ok(s.reroll_button.disabled == (run.essence < run.reroll_cost()) and s.reroll_button.text.ends_with(str(run.reroll_cost())), "%s: reroll button" % where)
	for cat in CribData.LEVEL_CATS:
		ok(s.level_buttons[cat].disabled == (run.essence < run.level_cost_for(cat)), "%s: level %s disabled" % [where, cat])
	var sellable := []
	for c in run.active_charms():
		if c.tier != 0:
			sellable.append(c.id)
	var got_sell: Array = s.sell_buttons.keys()
	got_sell.sort()
	sellable.sort()
	ok(got_sell == sellable, "%s: sell buttons %s want %s" % [where, got_sell, sellable])


## Every control inside the screen width; NEXT ROUND in the bottom quarter
## when the content fits without scrolling.
func check_layout(s: ShopScreen, where: String) -> void:
	var w := float(root.size.x)
	var all: Array = [s.reroll_button, s.next_button]
	all.append_array(s.offer_buttons.values())
	all.append_array(s.card_buttons.values())
	all.append_array(s.level_buttons.values())
	all.append_array(s.sell_buttons.values())
	for c in all:
		var r: Rect2 = c.get_global_rect()
		ok(r.position.x >= 0.0 and r.end.x <= w + 0.5 and r.size.x >= 30.0 and r.size.y >= 24.0, "%s: %s at %s off screen or tiny" % [where, c.name, r])
	if s.content_height() <= float(root.size.y) + 0.5:
		var nb: Rect2 = s.next_button.get_global_rect()
		ok(nb.end.y <= root.size.y and nb.position.y >= root.size.y * 0.75, "%s: NEXT ROUND at %s not in the thumb zone" % [where, nb])


func _go() -> void:
	P = load("res://tests/parity_test.gd")
	var f := FileAccess.open("res://tests/fixtures/parity.json", FileAccess.READ)
	var fx = P.norm(JSON.parse_string(f.get_as_text()))
	Achv.persist = false
	var shapes_fit := {}
	var acts := {}
	var si := 0
	for sc in fx.shopui:
		var cfg = sc.cfg
		root.size = SHAPES[si % SHAPES.size()]
		var where0 := "scenario %d %s" % [si, root.size]
		si += 1
		Achv.save_store({"__v": 3})
		for sy in cfg.systems:
			Achv.grant_system(sy)
		JS.unseeded = JsRng.new(fx.unseeded)
		var run := CribRun.new(cfg.meld, Meta.STREETS[int(cfg.street) - 1], null, int(cfg.seed))
		for id in cfg.own:
			var c := CribData.charm_by_id(id)
			run.charms.append(c)
			if c.on_acquire.is_valid():
				c.on_acquire.call(run)
		run.essence = int(cfg.essence)
		var s: ShopScreen = load("res://scenes/shop_screen.tscn").instantiate()
		root.add_child(s)
		s.open(run)
		await process_frame
		await process_frame
		for st in sc.steps:
			var where := "%s step %d %s" % [where0, steps_done, st.act]
			if st.act != null:
				var act: Array = st.act
				acts[act[0]] = acts.get(act[0], 0) + 1
				var c := control_for(s, act)
				ok(c != null, "%s: no control on screen" % where)
				if c == null:
					break
				ok(not c.disabled, "%s: control disabled" % where)
				s._scroll.ensure_control_visible(c)
				await process_frame
				var before := snap(run)
				await _click(c.get_global_rect().get_center())
				ok(P.diff(before, snap(run)) != "", "%s: click did nothing" % where)
				await process_frame
			var d: String = P.diff(st.state, snap(run))
			ok(d == "", "%s: run differs from JS: %s" % [where, d])
			if d != "":
				break
			check_display(s, run, where)
			check_layout(s, where)
			steps_done += 1
		if s.content_height() <= float(root.size.y) + 0.5:
			shapes_fit[root.size] = shapes_fit.get(root.size, 0) + 1
		root.remove_child(s)
		s.free()
	print("shop steps: %d, clicks: %d, actions %s, scenarios fitting without scroll %s" % [steps_done, clicks, acts, shapes_fit])
	var good := fails == 0 and steps_done >= 400 and clicks >= 350 and acts.size() == 5 and shapes_fit.size() == 3
	print("shop checks: %d, failures: %d" % [checks, fails])
	print("SHOP OK" if good else "SHOP FAILED")
	quit(0 if good else 1)
