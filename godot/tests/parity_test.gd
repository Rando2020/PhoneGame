extends SceneTree
## Headless parity test: replays tools/parity fixtures (generated by running the
## real web/ JS engine) and requires the GDScript engine to reproduce them.
##
##   godot --headless --path godot --script res://tests/parity_test.gd
##
## Exit code 0 = exact parity. Regenerate fixtures after any engine change:
##   node tools/parity/gen_fixtures.js

const FIXTURE := "res://tests/fixtures/parity.json"
const MAX_REPORT := 6

var fails := {}
var passes := {}
var reported := {}


func _initialize() -> void:
	var f := FileAccess.open(FIXTURE, FileAccess.READ)
	if f == null:
		printerr("missing fixture: run node tools/parity/gen_fixtures.js")
		quit(2)
		return
	var fx = norm(JSON.parse_string(f.get_as_text()))
	var t0 := Time.get_ticks_msec()
	test_rng(fx)
	test_count(fx)
	test_keep(fx)
	test_peg(fx)
	test_recut(fx)
	var runner = load("res://tests/parity_runs.gd")
	if runner != null and runner.can_instantiate():
		runner.new().run(self, fx)
	var lim: int = fx.runs.size()
	if OS.get_environment("PARITY_RUNS") != "":
		lim = mini(lim, int(OS.get_environment("PARITY_RUNS")))
	if OS.get_environment("PARITY_ONLY") != "":
		lim = OS.get_environment("PARITY_ONLY").split(",").size()
	expect("runs", lim)
	# A GDScript runtime error aborts a function without throwing, so a crashed
	# group would otherwise look like a clean pass. Every case must be accounted for.
	expect("rng", fx.rng.size()); expect("daily", fx.daily.size())
	expect("count", fx.count.size()); expect("keep", fx.keep.size())
	expect("keepevfast", fx.keep.size()); expect("keepoptEV", fx.keep.size())
	expect("keepEV", fx.keepev.size()); expect("peg", fx.peg.size())
	expect("pegplay", fx.pegplay.size())
	expect("recut", fx.recut.size())
	var total_fail := 0
	print("")
	for k in passes.keys() + fails.keys():
		if reported.has("_sum_" + k):
			continue
		reported["_sum_" + k] = true
		var p: int = passes.get(k, 0)
		var q: int = fails.get(k, 0)
		total_fail += q
		print("%-10s %6d pass  %4d fail" % [k, p, q])
	print("\n%s in %d ms" % ["PARITY OK" if total_fail == 0 else "PARITY FAILED", Time.get_ticks_msec() - t0])
	quit(0 if total_fail == 0 else 1)


# ------------------------------------------------------------------ helpers
## JSON gives floats for every number; restore ints where the value is integral.
static func norm(v):
	match typeof(v):
		TYPE_FLOAT:
			return int(v) if v == floor(v) and absf(v) < 9.0e15 else v
		TYPE_ARRAY:
			return v.map(func(x): return norm(x))
		TYPE_DICTIONARY:
			var d := {}
			for k in v:
				d[k] = norm(v[k])
			return d
	return v


## Deep compare with JS number semantics. Returns "" or a path to the mismatch.
static func diff(a, b, where := "") -> String:
	if JS.is_num(a) and JS.is_num(b):
		if a == b or absf(float(a) - float(b)) <= 1e-9 * maxf(1.0, absf(float(a))):
			return ""
		return "%s: %s != %s" % [where, str(a), str(b)]
	if typeof(a) != typeof(b):
		return "%s: type %s vs %s (%s | %s)" % [where, type_string(typeof(a)), type_string(typeof(b)), str(a), str(b)]
	if typeof(a) == TYPE_ARRAY:
		if a.size() != b.size():
			return "%s: length %d != %d" % [where, a.size(), b.size()]
		for i in a.size():
			var d := diff(a[i], b[i], "%s[%d]" % [where, i])
			if d != "":
				return d
		return ""
	if typeof(a) == TYPE_DICTIONARY:
		for k in a:
			if not b.has(k):
				return "%s.%s missing" % [where, k]
		for k in b:
			if not a.has(k):
				return "%s.%s unexpected" % [where, k]
			var d := diff(a[k], b[k], "%s.%s" % [where, k])
			if d != "":
				return d
		return ""
	return "" if a == b else "%s: %s != %s" % [where, str(a), str(b)]


func check(group: String, case_id, expected, got) -> bool:
	var d := diff(expected, got)
	if d == "":
		passes[group] = passes.get(group, 0) + 1
		return true
	fails[group] = fails.get(group, 0) + 1
	var n: int = reported.get(group, 0)
	if n < MAX_REPORT:
		print("FAIL %s #%s %s" % [group, str(case_id), d])
	reported[group] = n + 1
	return false


func expect(group: String, n: int) -> void:
	var seen: int = passes.get(group, 0) + fails.get(group, 0)
	if seen != n:
		print("FAIL %s: only %d of %d cases ran (runtime error?)" % [group, seen, n])
		fails[group] = fails.get(group, 0) + (n - seen)


static func card_out(c: Dictionary) -> Dictionary:
	var o := {"rank": c.rank, "suit": c.suit}
	for k in ["enh", "rank2", "suit2", "split"]:
		if c.has(k):
			o[k] = c[k]
	return o


static func events_out(evs: Array) -> Array:
	return evs.map(func(e): return {"kind": e.kind, "label": e.label, "points": e.points,
		"cards": e.cards.map(func(c): return card_out(c))})


# ------------------------------------------------------------------ groups
func test_rng(fx) -> void:
	for r in fx.rng:
		var g := JsRng.new(r.seed)
		var seq := []
		for i in r.seq.size():
			seq.append(g.next())
		check("rng", r.seed, r.seq, seq)
	for d in fx.daily:
		check("daily", d.key, d.seed, Meta.daily_seed(d.key))


func test_count(fx) -> void:
	for i in fx.count.size():
		var c = fx.count[i]
		var r := Cribbage.count_hand(c.hand, c.starter, c.isCrib, c.mods)
		check("count", i, {"base": c.base, "events": c.events}, {"base": r.base, "events": events_out(r.events)})


func test_keep(fx) -> void:
	for i in fx.keep.size():
		var k = fx.keep[i]
		check("keep", i, k.options, Cribbage.keep_options(k.dealt, k.starter, k.keep, k.mods))
		check("keepevfast", i, k.evfast, Cribbage.keep_ev_fast(k.dealt.slice(0, k.keep), k.pool, k.mods))
		check("keepoptEV", i, k.optionsEV, Cribbage.keep_options_ev(k.dealt, k.pool, k.keep, k.mods))
	for i in fx.keepev.size():
		var k = fx.keepev[i]
		check("keepEV", i, [k.ev, k.best], [Cribbage.keep_ev(k.dealt, [0, 1, 2, 3], k.mods),
			Cribbage.best_keep_by_ev(k.dealt, 4, k.mods)])


func test_peg(fx) -> void:
	for i in fx.peg.size():
		check("peg", i, fx.peg[i].out, PegPlay.peg_score(fx.peg[i].pile))
	for i in fx.pegplay.size():
		var c = fx.pegplay[i]
		var p := PegPlay.new(null, c.mine, c.theirs)
		p.step()
		var guard := 0
		while not p.over and guard < 20:
			guard += 1
			var k := -1
			for j in p.mine.size():
				if p.playable(j):
					k = j
					break
			p.lay("you", p.mine[k])
			p.turn = "them"
			p.step()
		var log := p.log.map(func(l): return {"who": l.who, "label": l.label, "points": l.points})
		check("pegplay", i, {"score": c.score, "oppScore": c.oppScore, "log": c.log},
			{"score": p.score, "oppScore": p.opp_score, "log": log})


## recuts2: a blind cut that adds nothing to the kept hand is re-cut.
func test_recut(fx) -> void:
	var autos := 0
	for i in fx.recut.size():
		var c = fx.recut[i]
		var run := CribRun.new(c.meld, Meta.STREETS[0], null, int(c.seed))
		for id in c.ids:
			run.charms.append(CribData.charm_by_id(id))
		var rd := CribRound.new(run)
		var deals := []
		while not rd.over and rd.deals_left > 0 and deals.size() < 6:
			if rd.new_deal() == null:
				break
			var res = rd.commit(rd.best_keep_ev().idx)
			autos += rd.auto_recuts
			deals.append({"starter": "%d%s" % [rd.starter.rank, rd.starter.suit], "auto": rd.auto_recuts,
				"total": res.total, "score": rd.score, "stock": rd.stock.size()})
		check("recut", i, c.deals, deals)
	if autos == 0:
		check("recut", "any", "some auto re-cuts", "none at all")
