[config]
name="MeldStore"
binary="meld_store.xcframework"
initialization="init_meld_store"
deinitialization="deinit_meld_store"

[dependencies]
linked=[]
embedded=[]
system=["StoreKit.framework"]
capabilities=[]
files=[]
linker_flags=["-L$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)", "-L$(SDKROOT)/usr/lib/swift", "-Wl,-rpath,/usr/lib/swift"]

[plist]
